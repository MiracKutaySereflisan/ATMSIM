<?xml version="1.0" encoding="utf-8"?>
<!--
  NuGet.config - Says that this repository downloads nothing.

  Why it exists: without this file the .NET SDK tries to reach the public package
  feed on every build, which costs time on a good network and fails outright on a
  restricted one. Clearing the source list makes that attempt impossible, so a build
  that succeeds here is proof that the repository has no external dependencies -
  rather than proof that the network happened to be up.

  Adding a package back is therefore a visible, deliberate edit to this file, not
  something that happens by accident. See karar kaydı KARAR-006.
-->
<configuration>
  <packageSources>
    <clear />
  </packageSources>
</configuration>
